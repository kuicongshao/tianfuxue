{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tianfu Corpus Item Manifest",
  "type": "object",
  "required": ["title", "layer", "source_type", "ingest_status"],
  "properties": {
    "title": { "type": "string" },
    "layer": {
      "type": "string",
      "enum": ["papers", "gazetteers", "ancient_books", "wechat_articles", "web_resources", "images", "maps", "multimedia"]
    },
    "source_type": {
      "type": "string",
      "enum": ["pdf", "docx", "txt", "markdown", "html", "web_article", "wechat_article", "gazetteer", "ancient_book", "image", "map", "audio", "video"]
    },
    "authors": { "type": "array", "items": { "type": "string" } },
    "year": { "type": ["integer", "null"] },
    "journal": { "type": ["string", "null"] },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "abstract": { "type": ["string", "null"] },
    "doi": { "type": ["string", "null"] },
    "citation": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"] },
    "local_path": { "type": ["string", "null"] },
    "pdf_path": { "type": ["string", "null"] },
    "ocr_path": { "type": ["string", "null"] },
    "embedding_model": { "type": ["string", "null"] },
    "ingest_status": {
      "type": "string",
      "enum": ["raw", "parsed", "cleaned", "chunked", "embedded", "indexed", "failed"]
    },
    "checksum": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"] }
  }
}
